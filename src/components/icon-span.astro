<style>
    .icon-span {
        display: flex;
        align-items: start;
        gap: 1rem;
    }

    .icon-container {
        display: flex;
        justify-content: center;
        align-items: center;

        aspect-ratio: 1/1;
        height: 3.1rem;
        
        padding: .5rem;
        
        font-size: 1.4rem;
        
        border-radius: var(--radius);

        background-color: var(--c-surface-alt);
        box-shadow: 2px 2px 0px 0px var(--c-outline-h);
        border: 1px solid black;
        
    }

    h2 {
        line-height: 1.0;
    }
</style>

<div class="icon-span">
    <div class="icon-container">
        <slot name="icon">a</slot>
    </div>
    <div class="">
        <slot />
    </div>
</div>