---

import Card from '../components/card.astro';
import BaseLayout from '../layouts/base.astro';
import Map from '../components/map.astro';
import IconSpan from '../components/icon-span.astro';
import PersonTile from '../components/person-tile.astro';
import AccountNumber from '../components/account-number.astro';

---

<style>
    .base {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .contact {

        min-height: 55vh;
        height: 100%;

        display: flex;
        flex-direction: row;
        gap: 1rem;
    
        overflow: visible;

        width: 100vw;
        max-width: 1200px;
        margin: 0 auto;
    
        align-items: stretch;
        align-content: stretch;
        justify-content: stretch;
        justify-items: stretch;
    }

    .map-container {
        flex: 2;
        padding: 0;
        min-height: 100%;
    }

    .map {
        height: 100%;
    }

    .cards-wrapper { 
        display: flex;
        flex-direction: column;
        gap: 1rem;

        max-width: 45%;
    }

    .person-tiles {
        display: flex;
        overflow-x: scroll;
        gap: 1rem;
        padding-top: .75rem;
    }

    .branch-info {
        display: flex;
        flex-direction: column;
        gap: .5rem;
        padding: 1rem;
    }

    .bank-account > * {
        margin-block: .5rem;
    }

    .bank-account > p {
        font-size: smaller;
        color: #686868;
        
        text-align: justify;
    }

    .legal {
        flex: 0;

        display: flex;
        flex-direction: column;
        font-family: 'Courier New', Courier, monospace;

        padding: 1rem;

        background: #1E351E;
        border-color: #076407;
        color: #858F85;

        .name {
            font-weight: bold;
            color: #9FB09F;
        }

        .address {

        }

        .numbers {
            display: flex;
            flex-direction: row;
            gap: 10px;
            width: 100%;
        }
    }
</style>

<BaseLayout class="base">
	<section class="contact">
        <Card class="map-container">
            <Map class="map"/>
        </Card>
        
        <div class="cards-wrapper">
            <Card class="branch-info">
                <IconSpan icon="people">
                    <h3>Lokalizacja klubu</h3>
                    <div>Al. Politechniki 9, Łódź<br>Od tyłu VII DS</div>
                </IconSpan>
                <IconSpan icon="email">
                    <h3>Główny adres e-mail</h3>
                    <div>klub@plazik.pl</div>
                </IconSpan>
                <div class="person-tiles">
                    <PersonTile
                        name="Andrzej Sobański"
                        role="Prezes klubu"
                        email="a.sobanski@plazik.pl"
                        phone-number="+48 666 666 666"
                        
                    />
                    <PersonTile
                        name="Maja Górska"
                        role="Ekspert od PR"
                        email="m.gorska@plazik.pl"
                        phone-number="+48 666 666 666"
                    />
                    <PersonTile
                        name="Seweryn Woliński"
                        role="Naczelny informatyk"
                        email="s.wolinski@plazik.pl"
                        phone-number="+48 666 666 666"
                    />
                    <PersonTile
                        name="Tobiasz Grala"
                        role="Cała polska Grala"
                        email="t.grala@plazik.pl"
                        phone-number="+48 666 666 666"
                    />
                </div>
                <div class="bank-account">
                    <h3>Dane bankowe</h3>
                    <AccountNumber>PL 36 9999 9999 9999 9999 9999 9999</AccountNumber>
                    <p>
                        To konto służy do opłacania składek. <br />
                        W tytule podaj swój numer legitymacji klubowej, jeśli posiadasz.
                    </p>
                </div>
            </Card>
            <Card class="card legal">
                <span class="name">Studencki Klub Turystyczny "PŁazik"</span>
                <span class="address">Al. Politechniki 9, 93-590 Łódź</span>
                <span class="numbers">
                    KRS: 0000062600 |
                    NIP: 7271062488 |
                    REGON: 47074607200000
                </span>
            </Card>
        </div>
    </section>
</BaseLayout>